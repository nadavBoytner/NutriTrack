generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GoalType {
  cutting
  bulking
  maintain
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  profile       Profile?
  nutritionGoal NutritionGoal?
  logEntries    LogEntry[]
  weightEntries WeightEntry[]
}

model Profile {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  age       Int?
  heightCm  Int?
  weightKg  Float?
  goalType  GoalType?
}

model NutritionGoal {
  userId          String @id
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  dailyCalories   Int
  dailyCarbsG     Int
  dailyFatG       Int
  dailyProteinG   Int
}

model FoodItem {
  id              String  @id @default(uuid())
  externalId      String  @unique
  name            String
  caloriesPer100g Float
  carbsPer100g    Float
  fatPer100g      Float
  proteinPer100g  Float
  barcode         String?

  logEntries LogEntry[]
}

enum LogEntrySource {
  db
  manual
  ai_estimated
}

enum LogEntryUnit {
  g
  portion
}

model LogEntry {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  date         DateTime       @db.Date
  foodItemId   String?
  foodItem     FoodItem?      @relation(fields: [foodItemId], references: [id])
  customName   String?
  quantityG    Float
  quantityUnit LogEntryUnit   @default(g)
  calories     Float
  carbsG       Float
  fatG         Float
  proteinG     Float
  source       LogEntrySource
  createdAt    DateTime       @default(now())

  @@index([userId, date])
}

model WeightEntry {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date     DateTime @db.Date
  weightKg Float

  @@unique([userId, date])
}
